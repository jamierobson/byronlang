<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>byron</AssemblyName>
        <Company>Jamie Robson</Company>
        <Product>Byron</Product>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
      <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
      <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <None Include="Samples\*.*">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="Samples\trait-partial-symbols.by">
          <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <Target Name="EnsureEmptyOutputFolder" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug'">
        <RemoveDir Directories="$(OutDir)Out" Condition="Exists('$(OutDir)Out')" />
        <MakeDir Directories="$(OutDir)Out" />
    </Target>

    <ItemGroup>
      <ProjectReference Include="..\Byron.Compiler\Byron.Compiler.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Out\" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="LLVMSharp" Version="20.1.2" />
    </ItemGroup>

</Project>
